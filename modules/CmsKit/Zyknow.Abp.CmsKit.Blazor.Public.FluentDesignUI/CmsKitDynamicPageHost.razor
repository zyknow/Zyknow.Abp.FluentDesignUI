@using Volo.CmsKit.Contents
@using Volo.CmsKit.Public.Pages
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Volo.CmsKit.Public.GlobalResources
@using Zyknow.Abp.AspnetCore.Components.Web.FluentDesignTheme.Themes.FluentDesignTheme
@inherits FluentAbpComponentBase
@page "/{**Url}"

<HeadContent>
    @* ReSharper disable once OtherTagsInsideScript1 *@
    @if (Page != null)
    {
        if (!string.IsNullOrWhiteSpace(Page?.Title))
        {
            <title>@Page.Title</title>
        }

        <style>@((MarkupString)@$"{Page?.Style} {GlobalStyleResource?.Value}")</style>

        <script>@((MarkupString)@$"{Page?.Script} {GlobalScriptResource?.Value}")</script>
    }

</HeadContent>

@if (Page != null)
{
    <CmsKitDynamicPageCard>
        @((MarkupString)Page.Content)
    </CmsKitDynamicPageCard>
}

@code {

    [Parameter] public string Url { get; set; }
    [CascadingParameter] public CmsKitRouter CmsKitRouter { get; set; }
    public PageDto? Page => CmsKitRouter?.Page;
    public GlobalResourceDto? GlobalStyleResource => CmsKitRouter?.GlobalStyleResource;
    public GlobalResourceDto? GlobalScriptResource => CmsKitRouter?.GlobalScriptResource;

    protected override void OnInitialized()
    {
        if (Page == null)
        {
            NavigationManager.NavigateTo("404");
        }
    }

}