@page "/blogs/{BlogSlug}"
@using Volo.Abp.GlobalFeatures
@using Volo.CmsKit.Contents
@using Volo.CmsKit.GlobalFeatures
@using Volo.CmsKit.Localization
@using Volo.CmsKit.Public.Blogs
@using Volo.CmsKit.Tags
@using Zyknow.Abp.CmsKit.Blazor.Public.FluentDesignUI.Layouts
@using Volo.CmsKit.Users
@inherits FluentAbpComponentBase<CmsKitResource>

<FluentAdaptiveCard Class="blog-post-items-container">
    <FluentGrid Style="width: 100%">
        <FluentGridItem sm="12" md="6">
            <FluentAutocomplete Name="SelectedAuthor"
                                AutoComplete="off"
                                Label="@L["SelectedAuthor"]"
                                TOption="CmsUserDto"
                                ImmediateDelay="200"
                                Width="100%"
                                OptionStyle="min-width: 300px"
                                OnOptionsSearch="@OnUsersSearch"
                                Multiple="false"
                                OptionText="@(dto => $@"{dto.Name}")"
                                SelectedOption="@SelectedAuthor"
                                SelectedOptionChanged="@(v =>
                                                       {
                                                           SelectedAuthor = v;
                                                           InvokeAsync(() => LoadMoreBlogsAsync(true));
                                                       })"/>
        </FluentGridItem>
        <FluentGridItem sm="12" md="6" Justify="JustifyContent.FlexEnd">
            <FluentStack HorizontalAlignment="HorizontalAlignment.End" VerticalAlignment="VerticalAlignment.Center">
                @if (IsMarkedItemFeatureEnabled && CurrentUser.IsAuthenticated)
                {
                    Icon icon = FilterOnFavorites == true
                        ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size16.Heart()
                        : new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Heart();
                    <FluentButton OnClick="@(() =>
                                           {
                                               if (FilterOnFavorites == null)
                                                   FilterOnFavorites = true;
                                               else
                                                   FilterOnFavorites = !FilterOnFavorites;
                                               InvokeAsync(() => LoadMoreBlogsAsync(true));
                                           })">
                        <FluentIcon Value="@icon" Color="Color.Custom" CustomColor="red" Slot="start"/>
                        @L["FilterOnFavorites"]
                    </FluentButton>
                }
            </FluentStack>
        </FluentGridItem>
        @if (TagId != null)
        {
            <FluentGridItem sm="12">
                <FluentLabel Typo="Typography.H4">@L["Tags"]</FluentLabel>
                <FluentBadge Appearance="Appearance.Accent">
                    @FilteredTagName
                </FluentBadge>
            </FluentGridItem>
        }
    </FluentGrid>

    <FluentDivider Style="width: 100%;margin-bottom: 10px;margin-top: 10px"
                   Orientation="Orientation.Horizontal"></FluentDivider>

    <FluentLabel Weight="FontWeight.Bold">@L["Total"]: @TotalItemCount</FluentLabel>

    <FluentGrid Style="width:100%" Class="blogs-container" AdaptiveRendering="true" Spacing="10"
                Justify="JustifyContent.FlexStart">
        @foreach (var post in Blogs)
        {
            <FluentGridItem sm="12" md="6" lg="4">
                <CmsBlogPostCardItem BlogSlug="@BlogSlug" IsMarkedItemFeatureEnabled="@IsMarkedItemFeatureEnabled"
                                     Post="@post"></CmsBlogPostCardItem>
            </FluentGridItem>
        }
    </FluentGrid>

    <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="margin-top: 50px">
        <FluentButton OnClick="@(() => LoadMoreBlogsAsync())" Loading="@Loading">@L["LoadMore"]</FluentButton>
    </FluentStack>
</FluentAdaptiveCard>

@code {
    [Inject] public IBlogPostPublicAppService BlogPostPublicAppService { get; set; }
    [Inject] public IBlogFeatureAppService BlogFeatureAppService { get; set; }
    [Inject] public ITagAppService TagAppService { get; set; }

    [Parameter] public string BlogSlug { get; set; }

    // [SupplyParameterFromQuery] public int CurrentPage { get; set; }

    [SupplyParameterFromQuery] public Guid? AuthorId { get; set; }

    [SupplyParameterFromQuery] public bool? FilterOnFavorites { get; set; }

    [SupplyParameterFromQuery] public Guid? TagId { get; set; }

    // protected PagedResultDto<BlogPostCommonDto> BlogPaged { get; set; }

    protected List<BlogPostCommonDto> Blogs { get; set; } = [];

    protected CmsUserDto? SelectedAuthor { get; set; }

    protected string FilteredTagName { get; set; }
    protected BlogFeatureDto MarkedItemsFeature { get; private set; }

    protected long TotalItemCount { get; set; }

    protected virtual int PageSize => 10;

    // protected AbpFluentPaginationState PaginationState { get; set; } = new()
    // {
    //     ItemsPerPage = 20
    // };

    protected bool Loading { get; set; }

    protected bool IsMarkedItemFeatureEnabled { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        await InitializeAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        IsMarkedItemFeatureEnabled = GlobalFeatureManager.Instance.IsEnabled<MarkedItemsFeature>();
    }

    protected async Task InitializeAsync()
    {
        if (AuthorId != null)
        {
            SelectedAuthor = await BlogPostPublicAppService.GetAuthorHasBlogPostAsync(AuthorId.Value);
        }

        await LoadMoreBlogsAsync(true);

        if (TagId is not null)
        {
            FilteredTagName = await BlogPostPublicAppService.GetTagNameAsync(TagId.Value);
        }

        if (IsMarkedItemFeatureEnabled &&
            Blogs.Any())
        {
            var blogId = Blogs.First().BlogId;
            MarkedItemsFeature =
                await BlogFeatureAppService.GetOrDefaultAsync(blogId, Volo.CmsKit.GlobalFeatures.MarkedItemsFeature.Name);
        }
    }

    protected async Task LoadMoreBlogsAsync(bool reload = false)
    {
        Loading = true;
        if (reload)
        {
            Blogs.Clear();
            TotalItemCount = 0;
        }

        try
        {
            var input = new BlogPostGetListInput
            {
                SkipCount = Blogs.Count,
                MaxResultCount = PageSize,
                AuthorId = SelectedAuthor?.Id,
                TagId = TagId,
                FilterOnFavorites = FilterOnFavorites
            };
            var res = await BlogPostPublicAppService.GetListAsync(
                BlogSlug,
                input
            );

            TotalItemCount = res.TotalCount;
            Blogs.AddRange(res.Items);
        }
        catch (Exception e)
        {
            await HandleErrorAsync(e);
        }
        finally
        {
            Loading = false;
        }
    }


    protected virtual async Task OnUsersSearch(OptionsSearchEventArgs<CmsUserDto> arg)
    {
        arg.Text = arg.Text.Trim();
        var result = await BlogPostPublicAppService.GetAuthorsHasBlogPostsAsync(new()
        {
            Filter = arg.Text,
            MaxResultCount = 20
        });
        arg.Items = result.Items;
    }

}