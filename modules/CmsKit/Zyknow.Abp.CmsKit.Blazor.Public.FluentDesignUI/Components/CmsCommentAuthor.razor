@using Volo.CmsKit.Public.Comments
<FluentPersona Name="@Author.UserName"
               ImageSize="30px"
               StatusSize="PresenceBadgeSize.Small">
    @if (BlogSlug.IsNullOrWhiteSpace())
    {
        <FluentLabel>@@@Author.UserName</FluentLabel>
    }
    else
    {
        <FluentAnchor Href="@(@$"/blogs/{BlogSlug}?AuthorId={Author.Id}")"
                      Appearance="Appearance.Hypertext">@@@Author.UserName</FluentAnchor>
    }

</FluentPersona>

@code {
    [Parameter] public string? BlogSlug { get; set; }

    [Parameter] [EditorRequired] public CmsUserDto Author { get; set; }
}