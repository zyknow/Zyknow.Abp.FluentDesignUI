@using Volo.CmsKit.Localization

<FluentIcon Slot="start" Id="@_iconId" Value="@Icon"
            Color="Color.Custom" CustomColor="red" OnClick="@ToggleMarkedItemAsync"/>

<FluentTooltip Anchor="@_iconId">
    @L["ToggleFavorite"]
</FluentTooltip>

@code {
    [Parameter] public string EntityType { get; set; }
    [Parameter] public string EntityId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Inject] public IMarkedItemPublicAppService MarkedItemPublicAppService { get; set; }
    [Inject] public IStringLocalizer<CmsKitResource> L { get; set; }

    MarkedItemWithToggleDto MarkedItem { get; set; }

    string _iconId = Guid.NewGuid().ToString();

    Icon Icon =>
        MarkedItem.IsMarkedByCurrentUser
            ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size24.Heart()
            : new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Heart();


    protected override async Task OnInitializedAsync()
    {
        MarkedItem = await MarkedItemPublicAppService.GetForUserAsync(EntityType, EntityId);
    }

    protected async Task ToggleMarkedItemAsync()
    {
        if (ReadOnly)
            return;
        
        MarkedItem.IsMarkedByCurrentUser = await MarkedItemPublicAppService.ToggleAsync(EntityType, EntityId);
        await InvokeAsync(StateHasChanged);
    }

}