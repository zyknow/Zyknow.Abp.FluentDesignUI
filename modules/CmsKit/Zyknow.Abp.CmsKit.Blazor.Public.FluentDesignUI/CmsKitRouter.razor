@using System.Reflection
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Volo.Abp.Features
@using Volo.Abp.GlobalFeatures
@using Volo.CmsKit.Contents
@using Volo.CmsKit.GlobalFeatures
@using Volo.CmsKit.Public.GlobalResources
@using Volo.CmsKit.Public.Pages
@using Zyknow.Abp.AspnetCore.Components.Web.FluentDesignTheme.Themes.FluentDesignTheme
@using Zyknow.Abp.CmsKit.Blazor.Public.FluentDesignUI.Pages
@inject IPagePublicAppService PageService
<CascadingValue Value="this" IsFixed="true">
    <Router
        AppAssembly="@AppAssembly"
        AdditionalAssemblies="@AdditionalAssemblies"
        OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            @{
                var currentRouteData = (HasDynamicHomePage && _currentSlug.IsNullOrWhiteSpace() ? _homeRouteData : routeData)!;

                if (PageFound != null)
                {
                    PageFound(new CmsKitRouterData(currentRouteData, CurrentLayout));
                }
                else
                {
                    <AuthorizeRouteView RouteData="currentRouteData"
                                        DefaultLayout="CurrentLayout">
                        <NotAuthorized>
                            <RedirectToLogin/>
                        </NotAuthorized>
                    </AuthorizeRouteView>
                }
            }
        </Found>
    </Router>
</CascadingValue>

@code {

    [Parameter, EditorRequired] public Assembly AppAssembly { get; set; }

    [Parameter] public IEnumerable<Assembly> AdditionalAssemblies { get; set; }

    [Parameter] public RenderFragment<CmsKitRouterData>? PageFound { get; set; }

    [Inject] protected IOptions<AbpFluentDesignThemeOptions> ThemeOptions { get; set; } = null!;

    [Inject] protected ILogger<CmsKitRouter> Logger { get; set; } = null!;

    [Inject] protected IGlobalResourcePublicAppService GlobalResourceService { get; set; } = null!;

    public PageDto? Page { get; set; }
    public Type CurrentLayout => _layout ?? typeof(DefaultLayout);

    public GlobalResourceDto? GlobalStyleResource { get; set; }
    public GlobalResourceDto? GlobalScriptResource { get; set; }

    private string _currentSlug;
    bool HasDynamicHomePage => PageDtoCaches.GetValueOrDefault("") != null;
    Type? _layout;

    public Dictionary<string, PageDto?> PageDtoCaches { get; set; } = [];

    private readonly RouteData _homeRouteData = new(typeof(CmsKitDynamicPageHost),
        new Dictionary<string, object>
        {
            ["Url"] = "/"
        }!);

    private bool _isCmsPageEnabled;

    protected override async Task OnInitializedAsync()
    {
        _isCmsPageEnabled = GlobalFeatureManager.Instance.IsEnabled<PagesFeature>();

        if (!_isCmsPageEnabled)
            return;
        try
        {
            PageDtoCaches[""] = (await PageService.FindDefaultHomePageAsync());
        }
        catch (Exception e)
        {
        }
    }

    private async Task OnNavigateAsync(NavigationContext args)
    {
        _currentSlug = args.Path;
        await SetPageAsync();
    }

    async Task SetPageAsync()
    {
        _layout = null;
        Page = null;
        try
        {
            Page = await GetDynamicPageAsync(_currentSlug);

            if (Page != null || _currentSlug.Contains("blogs/"))
                await GetGlobalResourceAsync();

            _layout = ThemeOptions.Value.GetLayout(Page?.LayoutName!).Type;
        }
        catch (Exception e)
        {
            Logger.LogError(e, e.Message);
        }
        finally
        {
        }
    }

    async Task GetGlobalResourceAsync()
    {
        if (GlobalStyleResource != null || GlobalScriptResource != null)
            return;

        try
        {
            GlobalScriptResource = await GlobalResourceService.GetGlobalScriptAsync();
            GlobalStyleResource = await GlobalResourceService.GetGlobalStyleAsync();
        }
        catch (Exception e)
        {
            Logger.LogError(e, e.Message);
        }
    }


    async Task<PageDto?> GetDynamicPageAsync(string slug)
    {
        if (PageDtoCaches.TryGetValue(slug, out var page))
        {
            return page;
        }

        // if (slug.IsNullOrWhiteSpace())
        // {
        //     PageDtoCaches[slug] = await PageService.FindDefaultHomePageAsync();
        // }


        if (!(await PageService.DoesSlugExistAsync(slug)))
        {
            PageDtoCaches[slug] = null;
        }

        PageDtoCaches[slug] = await PageService.FindBySlugAsync(slug);

        return PageDtoCaches[slug];
    }

}