@page "/Cms/Comments"
@attribute [Authorize(CmsKitAdminPermissions.Comments.Default)]
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Localization
@using Volo.CmsKit.Admin.Comments
@using Volo.CmsKit.Comments
@using Volo.CmsKit.Permissions
@using Size20 = Microsoft.FluentUI.AspNetCore.Components.Icons.Filled.Size20
@using TKey = Guid
@using TGetListOutputDto = Volo.CmsKit.Admin.Comments.CommentWithAuthorDto
@using TGetListInput = Volo.CmsKit.Admin.Comments.CommentGetListInput
@using TResource = Volo.CmsKit.Localization.CmsKitResource
@using TAppService = Volo.CmsKit.Admin.Comments.ICommentAdminAppService
@inherits AbpGetListPageBase<TGetListOutputDto, TKey, TGetListInput>

<FluentAdaptiveCard>

    @if (!IsInCommentInfoView)
    {
        <AbpPageHeader Title="@L["Comments"]" BreadcrumbItems="@BreadcrumbItems"/>
    }

    <AbpSearch Loading="@Loading" PrimaryInputVisible="false"
               OnSearch="SearchEntitiesAsync" ChildrenFilterVisible="true">
        <FluentStack>
            <div>
                <FluentDateTimePicker @bind-Value="@GetListInput.CreationStartDate"
                                      Label="@L["StartDate"]"></FluentDateTimePicker>
            </div>
            <div>
                <FluentDateTimePicker @bind-Value="@GetListInput.CreationEndDate"
                                      Label="@L["EndDate"]"></FluentDateTimePicker>
            </div>

            <div>
                <FluentTextField @bind-Value="@GetListInput.Author"
                                 Placeholder="@L["Username"]"
                                 Label="@L["Username"]"/>
            </div>

            <div>
                @{
                    var commentApproveStateValues = Enum.GetValues<CommentApproveState>();
                    <FluentSelect TOption="CommentApproveState"
                                  Items="@commentApproveStateValues"
                                  OptionText="@(state => L[@$"CmsKit.Comment.ApproveStates.{(int)state}"])"
                                  @bind-SelectedOption="@GetListInput.CommentApproveState"
                                  Label="@L["CommentFilter:ApproveState"]"></FluentSelect>
                }

            </div>

            @if (!IsInCommentInfoView)
            {
                <div>
                    <FluentTextField @bind-Value="@GetListInput.EntityType"
                                     Placeholder="@L["EntityType"]"
                                     Label="@L["EntityType"]"/>
                </div>
            }

        </FluentStack>
    </AbpSearch>

    <AbpExtensibleDataGrid Loading="@Loading"
                           TKey="TKey"
                           TItem="TGetListOutputDto"
                           EnableSelected="true"
                           PrimarySelectedDeletesBtnVisible="@HasDeletePermission"
                           OnDeleteSelected="DeleteEntitiesAsync"
                           GetItemKey="x => x.Id"
                           DeleteSelectedDisplayPropertyConfirmExpression="@(r => r.Text)"
                           Entities="Entities"
                           OnChange="@OnDataGridReadAsync"
                           Pagination="@Pagination"
                           @bind-SelectEntities="@SelectedEntities"
                           Columns="@CommentManagementTableColumns">
        <SelectToolbarEnd>
            <FluentButton Disabled="@(SelectedEntities.IsNullOrEmpty())" Appearance="Appearance.Stealth"
                          OnClick="OnApproveSelectedClick">@L["Approve"]@L["Selected"]</FluentButton>

            <FluentButton Disabled="@(SelectedEntities.IsNullOrEmpty())" Appearance="Appearance.Stealth"
                          OnClick="OnDisapprovedSelectedClick">@L["Disapproved"]@L["Selected"]</FluentButton>
        </SelectToolbarEnd>
    </AbpExtensibleDataGrid>
</FluentAdaptiveCard>

@code
{
    protected bool HasDeletePermission;
    protected PageToolbar Toolbar { get; } = new();

    [Parameter] public bool IsInCommentInfoView { get; set; }

    [Parameter] public Guid? RepliedCommentId { get; set; }

    [Inject] protected TAppService AppService { get; set; }

    protected List<TGetListOutputDto> SelectedEntities { get; set; } = [];

    protected List<FluentTableColumn> CommentManagementTableColumns => TableColumns.Get<CommentManagement>();

    public CommentManagement()
    {
        LocalizationResource = typeof(TResource);
    }

    protected override async Task OnParametersSetAsync()
    {
        await GetEntitiesAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        HasDeletePermission = await AuthorizationService.IsGrantedAsync(CmsKitAdminPermissions.Comments.Delete);
        await base.OnInitializedAsync();
    }

    protected override ValueTask SetBreadcrumbItemsAsync()
    {
        BreadcrumbItems.Add(new AbpBreadcrumbItem(L["Menu:CMS"], icon: new Size16.News()));
        BreadcrumbItems.Add(new AbpBreadcrumbItem(L["Comments"]));

        return base.SetBreadcrumbItemsAsync();
    }

    protected override ValueTask SetEntityActionsAsync()
    {
        EntityActions
            .Get<CommentManagement>()
            .AddRange([
                new FluentEntityAction
                {
                    Text = L["Detail"],
                    Clicked = async (data) =>
                    {
                        var entity = data.As<TGetListOutputDto>();
                        NavigationManager.NavigateTo($"/Cms/Comments/{entity.Id}");
                    }
                },
                new FluentEntityAction
                {
                    Text = L["Approve"],
                    Visible = data => data.As<TGetListOutputDto>().IsApproved != true,
                    Clicked = async (data) =>
                    {
                        var entity = data.As<TGetListOutputDto>();
                        await AppService.UpdateApprovalStatusAsync(entity.Id, new CommentApprovalDto()
                        {
                            IsApproved = true
                        });

                        entity.IsApproved = true;
                        await InvokeAsync(StateHasChanged);
                    }
                },
                new FluentEntityAction
                {
                    Text = L["Disapproved"],
                    Visible = data => data.As<TGetListOutputDto>().IsApproved != false,
                    Clicked = async (data) =>
                    {
                        var entity = data.As<TGetListOutputDto>();
                        await AppService.UpdateApprovalStatusAsync(entity.Id, new CommentApprovalDto()
                        {
                            IsApproved = false
                        });
                        entity.IsApproved = false;
                        await InvokeAsync(StateHasChanged);
                    }
                },
                new FluentEntityAction
                {
                    Text = L["Delete"],
                    Color = "red",
                    Visible = (data) => HasDeletePermission,
                    Clicked = async (data) => { }
                }
            ]);

        return base.SetEntityActionsAsync();
    }

    protected Icon GetIsApprovedIcon(bool? isApproved)
    {
        if (isApproved == null)
        {
            return new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.HourglassThreeQuarter();
        }

        return isApproved == true
            ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.CheckmarkCircle()
            : new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.DismissCircle();
    }

    protected override ValueTask SetTableColumnsAsync()
    {
        CommentManagementTableColumns
            .AddRange([
                new FluentTableColumn
                {
                    Title = L["Username"],
                    Sortable = false,
                    Data = nameof(TGetListOutputDto.Author),
                    PropertyName = nameof(TGetListOutputDto.Author),
                    ValueConverter = v => (v as TGetListOutputDto)?.Author?.Name
                },
                new FluentTableColumn
                {
                    Title = L["EntityType"],
                    Sortable = true,
                    Data = nameof(TGetListOutputDto.EntityType),
                    PropertyName = nameof(TGetListOutputDto.EntityType),
                },
                new FluentTableColumn
                {
                    Title = L["URL"],
                    Sortable = true,
                    Data = nameof(TGetListOutputDto.Url),
                    PropertyName = nameof(TGetListOutputDto.Url),
                    CustomRender = (data) =>
                    {
                        var entity = data.As<TGetListOutputDto>();
                        return @<div>
                            <FluentIcon Value="@(new Size20.Cursor())" OnClick="@(() => GotoUrlPageAsync(entity.Url))"/>
                        </div>;
                    }
                },
                new FluentTableColumn
                {
                    Title = L["Text"],
                    Sortable = true,
                    Data = nameof(TGetListOutputDto.Text),
                    PropertyName = nameof(TGetListOutputDto.Text)
                },
                new FluentTableColumn()
                {
                    Title = L["IsApproved"],
                    Sortable = true,
                    Data = nameof(TGetListOutputDto.IsApproved),
                    PropertyName = nameof(TGetListOutputDto.IsApproved),
                    CustomRender = (data) =>
                    {
                        var entity = data.As<TGetListOutputDto>();
                        Color color = Color.Accent;
                        if (entity.IsApproved == true)
                            color = Color.Success;
                        else if (entity.IsApproved == false)
                            color = Color.Error;
                        else
                        {
                            color = Color.Info;
                        }


                        return @<div>
                            <FluentIcon Color="@(color)" Value="@GetIsApprovedIcon(entity.IsApproved)"/>
                        </div>;
                    }
                },
                new FluentTableColumn
                {
                    Title = L["CreationTime"],
                    Sortable = true,
                    Data = nameof(TGetListOutputDto.CreationTime),
                    PropertyName = nameof(TGetListOutputDto.CreationTime)
                },
            ]);

        CommentManagementTableColumns.Add(new FluentTableColumn
        {
            Title = L["Actions"],
            Actions = EntityActions.Get<CommentManagement>()
        });

        return base.SetTableColumnsAsync();
    }

    protected virtual async Task OnDisapprovedSelectedClick()
    {
        Loading = true;
        var input = new CommentApprovalDto()
        {
            IsApproved = false
        };
        try
        {
            foreach (var commentWithAuthorDto in SelectedEntities.Where(x => x.IsApproved != false))
            {
                await AppService.UpdateApprovalStatusAsync(commentWithAuthorDto.Id, input);
            }

            SelectedEntities.Clear();
        }
        catch (Exception e)
        {
            await HandleErrorAsync(e);
        }
        finally
        {
            Loading = false;
            await GetEntitiesAsync();
        }
    }

    protected virtual async Task OnApproveSelectedClick()
    {
        Loading = true;
        var input = new CommentApprovalDto()
        {
            IsApproved = true
        };
        try
        {
            foreach (var commentWithAuthorDto in SelectedEntities.Where(x => x.IsApproved != true))
            {
                await AppService.UpdateApprovalStatusAsync(commentWithAuthorDto.Id, input);
            }

            SelectedEntities.Clear();
        }
        catch (Exception e)
        {
            await HandleErrorAsync(e);
        }
        finally
        {
            Loading = false;
            await GetEntitiesAsync();
        }
    }
}

@code {

    protected override async Task<IPagedResult<TGetListOutputDto>> AppServiceGetListAsync(TGetListInput input)
    {
        input.RepliedCommentId = RepliedCommentId;
        var res = await AppService.GetListAsync(input);
        return res;
    }

    protected virtual async Task DeleteEntitiesAsync(IEnumerable<TGetListOutputDto> entities)
    {
        if (!HasDeletePermission)
            return;

        entities = entities.ToList();
        var ids = entities.Select(e => e.Id).ToList();

        if (ids.IsNullOrEmpty()) return;

        try
        {
            foreach (var key in ids)
            {
                await AppServiceDeleteAsync(key);
            }
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    protected Task AppServiceDeleteAsync(Guid id) => AppService.DeleteAsync(id);


    protected void GotoUrlPageAsync(string url)
    {
        NavigationManager.NavigateTo(url, forceLoad: true);
    }


}

