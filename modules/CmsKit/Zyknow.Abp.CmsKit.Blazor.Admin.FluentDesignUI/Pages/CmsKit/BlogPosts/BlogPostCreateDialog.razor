@using Localization.Resources.AbpUi
@using Volo.CmsKit.Admin.Blogs
@using Volo.CmsKit.Admin.MediaDescriptors
@using Volo.CmsKit.Admin.Tags
@using Volo.CmsKit.Blogs
@using Volo.CmsKit.Permissions
@using TInput = Volo.CmsKit.Admin.Blogs.CreateBlogPostDto
@using TResource = Volo.CmsKit.Localization.CmsKitResource
@using TResult = BlogPostCreateResultModel
@inherits Zyknow.Abp.FluentDesignUI.AbpDialogFormBase<TResult, TInput, TResource>


<AbpFluentForm HeaderText="@L["NewBlogPost"]"
               Content="@Content"
               @ref="FormRef"
               SubmitValidClick="@(() => SubmitClick(ResModel))"
               CancelClick="CancelClick"
               Localize="@LH.Localize">

    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical">
            <FluentInputFile
                DragDropZoneVisible="false"
                Mode="InputFileMode.Stream"
                AnchorId="UploadStream"
                Accept=".jpg, .jpeg, .png, .webp, .gif"
                OnFileUploaded="@OnCoverUploadedAsync"/>

            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                         Style="margin-bottom: 10px">
                <FluentButton Appearance="Appearance.Accent" Id="UploadStream">
                    @L["CoverImage"] 16:9
                </FluentButton>
                <FluentLabel>@ResModel.FileName</FluentLabel>
            </FluentStack>


            <FluentAutocomplete
                Required
                Name="blogs"
                Field="@(new FieldIdentifier(Content, nameof(Content.BlogId)))"
                MaximumSelectedOptions="1"
                OptionText="@(dto => $@"{dto.Name}")"
                Width="300px"
                SelectedOptions="SelectedBlogs"
                SelectedOptionsChanged="@(blogs =>
                                        {
                                            SelectedBlogs = blogs;
                                            Content.BlogId = blogs?.FirstOrDefault()?.Id ?? Guid.Empty;
                                        })"
                ImmediateDelay="200"
                TOption="BlogDto"
                Label="@L["Blogs"]"
                OnOptionsSearch="@OnOptionsSearch"></FluentAutocomplete>

            <FluentTextField Style="width: 100%" Label="@L["BlogPostTitle"]" Value="@Content.Title"
                             ValueChanged="@SetTitle"/>
            <FluentValidationMessage For="@(() => Content.Title)"/>

            <FluentTextField Style="width: 100%" Label="@L["BlogPostSlug"]" @bind-Value="@Content.Slug"/>
            <FluentValidationMessage For="@(() => Content.Slug)"/>

            <FluentTextField Style="width: 100%" Label="@L["BlogPostShortDescription"]"
                             @bind-Value="@Content.ShortDescription"/>
            <FluentValidationMessage For="@(() => Content.ShortDescription)"/>

            <FluentTextField Style="width: 100%" Label="@($@"{@L["CmsKit.Tags"]} - ({@L["TagsHelpText"]})")"
                             @bind-Value="@ResModel.TagNameString"/>

            <ExtensionProperties TEntityType="TInput" TResourceType="TResource"
                                 Entity="@Content" LH="@LH"/>

            <CmsKitEditor @bind-Value="@Content.Content"></CmsKitEditor>

        </FluentStack>
    </ChildContent>


    <Footer>
        <FluentStack HorizontalAlignment="HorizontalAlignment.End" VerticalAlignment="VerticalAlignment.Bottom">
            <FluentButton Loading="@FormRef.Loading" Appearance="Appearance.Outline"
                          OnClick="@(() =>
                                   {
                                       ResModel.Status = BlogPostStatus.Draft;
                                       FormRef.OnSubmitBtnClickAsync();
                                   })">@L["SaveAsDraft"]</FluentButton>
            @if (CanPublish)
            {
                <FluentButton Loading="@FormRef.Loading" Appearance="Appearance.Accent"
                              OnClick="@(() =>
                                       {
                                           ResModel.Status = BlogPostStatus.Published;
                                           FormRef.OnSubmitBtnClickAsync();
                                       })">@L["Publish"]</FluentButton>
            }
        </FluentStack>
    </Footer>
</AbpFluentForm>

@code
{
    [Inject] protected IBlogAdminAppService BlogAdminAppService { get; set; }
    [Inject] protected IStringLocalizer<AbpUiResource> UL { get; set; }
    [Inject] protected IAuthorizationService AuthorizationService { get; set; }

    protected bool CanPublish = false;

    protected IEnumerable<BlogDto>? SelectedBlogs { get; set; }

    public BlogPostCreateResultModel ResModel { get; set; } = new();

    AbpFluentForm<TInput> FormRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ResModel.Dto = Content;
        CanPublish = (await AuthorizationService.AuthorizeAsync(CmsKitAdminPermissions.BlogPosts.Publish)).Succeeded;
    }

    private async Task OnOptionsSearch(OptionsSearchEventArgs<BlogDto> arg)
    {
        arg.Text = arg.Text.Trim();
        var result = await BlogAdminAppService.GetListAsync(new BlogGetListInput
        {
            Filter = arg.Text,
            MaxResultCount = 100
        });
        arg.Items = result.Items;
    }

    protected void SetTitle(string? title)
    {
        Content.Title = title;
        Content.Slug = title?.ToLower().Replace(" ", "-");
    }

    async Task OnCoverUploadedAsync(FluentInputFileEventArgs file)
    {
        var localFile = Path.GetTempFileName() + file.Name;
        ResModel.FileName = file.Name;
        ResModel.CoverImageStream = new(localFile, FileMode.Create);
        await file.Stream!.CopyToAsync(ResModel.CoverImageStream);
    }
}
