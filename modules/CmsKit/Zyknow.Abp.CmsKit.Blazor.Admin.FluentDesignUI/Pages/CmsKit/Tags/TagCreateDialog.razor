@using Volo.CmsKit.Admin.Tags
@using Volo.CmsKit.Tags
@using TInput = Volo.CmsKit.Admin.Tags.TagCreateDto
@using TResource = Volo.CmsKit.Localization.CmsKitResource
@inherits Zyknow.Abp.FluentDesignUI.AbpDialogFormBase<TInput, TResource>

<AbpFluentForm
    HeaderText="@HeaderText"
    Content="@Content"
    SubmitValidClick="SubmitClick"
    CancelClick="CancelClick"
    Localize="@LH.Localize">

    <FluentSelect Required TOption="TagDefinitionDto" Items="@_definitions" OptionValue="@(x => x.EntityType)"
                  @bind-Value="Content.EntityType" Label="@L["EntityType"]" OptionText="@(x => x.DisplayName)"/>
    <FluentValidationMessage For="@(() => Content.EntityType)"></FluentValidationMessage>
    <FluentTextField Required @bind-Value="Content.Name" Label="@L["Name"]"/>
    <FluentValidationMessage For="@(() => Content.Name)"></FluentValidationMessage>

</AbpFluentForm>

@code {
    private List<TagDefinitionDto> _definitions = new();

    [Inject] protected ITagAdminAppService AppService { get; set; } = null!;
    public string HeaderText => L["NewTag"];

    protected override async Task OnInitializedAsync()
    {
        _definitions = await AppService.GetTagDefinitionsAsync();
        if (Content.EntityType.IsNullOrWhiteSpace())
            Content.EntityType = "BlogPost";
    }

}