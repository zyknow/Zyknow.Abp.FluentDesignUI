@inherits FluentComponentBase

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch"
             VerticalAlignment="VerticalAlignment.Stretch" Style="@Style"
             Class="@(@$"fluent-adaptive-card fluent-card {Class}")" AdditionalAttributes="@AdditionalAttributes"
             Id="@Id">
    @if (ChildContent != null)
    {
        @ChildContent
    }
</FluentStack>


@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
}