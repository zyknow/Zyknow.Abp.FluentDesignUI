<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Version>1.0.0-preview.1</Version>
        <NoWarn>$(NoWarn);CS1591;NU1903;NU1902;NU1904;CS1998;CS8618;CS8603;CS8601;CS0105;CS0168;BL0005</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageProjectUrl>https://github.com/zyknow/Zyknow.Abp.FluentDesignUI</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/zyknow/Zyknow.Abp.FluentDesignUI</RepositoryUrl>
    </PropertyGroup>


    <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
        <PropertyGroup>
            <NoWarn>$(NoWarn);0436</NoWarn>
        </PropertyGroup>
    </Target>
</Project>